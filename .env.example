# Copy to .env.local. With nothing set, `npm run dev` uses an embedded database in .data/ and shows sign-in links on screen.

# Postgres connection string (Neon, Supabase or any Postgres). Required in production.
# A prefixed name such as STORAGE_DATABASE_URL, as Vercel creates, is also picked up.
DATABASE_URL=

# Public address of the site, used in sign-in links. Required in production, except on Vercel, which supplies it.
APP_URL=

# Email sending through Resend. Required in production so sign-in links can be delivered.
RESEND_API_KEY=
EMAIL_FROM=

# File uploads. Vercel sets this when a private Blob store is connected to the project. Leave empty to use links only.
BLOB_READ_WRITE_TOKEN=

# Public address of the app, used in emails. Required in production.
# APP_URL=https://setline.team
# Comma-separated emails of the people who run Setline. They can open /operator and set any workspace's plan.
SETLINE_OPERATOR_EMAILS=
# Shared secret for the daily trial-reminder job. Vercel sends it as a Bearer token.
CRON_SECRET=
# Shown on the billing page as the address to write to about plans.
SUPPORT_EMAIL=
